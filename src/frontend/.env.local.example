# Local single-user mode — Supabase is no longer required.

# Ollama (optional local models)
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434

# API Keys (at least one recommended)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=

# OpenAI API Information
NEXT_PUBLIC_OPENAI_ORGANIZATION_ID=

# Azure API Information (optional)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_GPT_35_TURBO_NAME=
AZURE_GPT_45_VISION_NAME=
AZURE_GPT_45_TURBO_NAME=
AZURE_EMBEDDINGS_NAME=

# File size limit for uploads in bytes
NEXT_PUBLIC_USER_FILE_SIZE_LIMIT=10485760

# MentorOS — Supervisor-Skills backend (local dev defaults)
SUPERVISOR_SKILLS_BACKEND_URL=http://localhost:6000
NEXT_PUBLIC_SUPERVISOR_SKILLS_BACKEND_URL=http://localhost:6000
SUPERVISOR_SKILLS_API_KEY=sk-demo

# Optional: OpenAI-compatible proxy base (trailing /v1 if required by your provider)
# OPENAI_API_BASE=
